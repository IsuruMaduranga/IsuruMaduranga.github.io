@inproceedings{wijesiri2026confident,
  title     = {Confident but Wrong: A Constrained Decoding Diagnostic for Low-Resource Automatic Post-Editing},
  author    = {Wijesiri, Isuru and others},
  booktitle = {Findings of the Association for Computational Linguistics: EMNLP 2026},
  year      = {2026},
  html      = {https://github.com/IsuruMaduranga/confident-but-wrong},
  abstract  = {A black-box, inference-time diagnostic for automatic post-editing (APE) that varies an edit-distance penalty between free editing and copying the machine-translation output. The resulting TER-vs-penalty curve exposes two systematic failure modes of low-resource fine-tuning, Binary Collapse and Confident Miscalibration, and prescribes a fix. The work releases the first English-Sinhala (~66k) and a new English-Tamil (~39k) APE datasets.},
  selected  = {true}
}

@article{wijesiri2026ensita,
  title    = {EnSiTa: A Trilingual Multi-Domain Parallel Dataset and Benchmark for Domain-Specific Machine Translation},
  author   = {Wijesiri, Isuru and others},
  journal  = {Preprint (under submission, targeting TACL)},
  year     = {2026},
  html     = {https://doi.org/10.13140/RG.2.2.28180.87688},
  abstract = {An English-Sinhala-Tamil parallel dataset built by professional post-editing of machine translation and web-mined corpora across multiple domains, released with a benchmark for domain-specific machine translation. It is the source of the APE data used in the EMNLP 2026 paper.}
}

@inproceedings{wijesiri2020memory,
  title     = {Memory-Efficient Graph Convolutional Network-Based Distributed Link Prediction},
  author    = {Wijesiri, Isuru and others},
  booktitle = {2020 IEEE International Conference on Big Data (Big Data)},
  year      = {2020},
  doi       = {10.1109/BigData50022.2020.9377874},
  html      = {https://ieeexplore.ieee.org/document/9377874},
  abstract  = {Introduces a memory-efficient, federated training scheme that partitions large graphs across JasmineGraph and runs parallel GCN workers. This lets a single commodity server train link-prediction models on datasets as big as DBLP-V11 (10+ GB) that conventional GCNs cannot load, and cuts training time by 3-5x on Reddit and Twitter graphs compared with standard, in-memory methods.},
  selected  = {true}
}

@article{wijesiri2020anomaly,
  title    = {Anomaly Detection using Deep Reconstruction and Forecasting for Autonomous Systems},
  author   = {Wijesiri, Isuru and others},
  journal  = {arXiv preprint arXiv:2006.14556},
  year     = {2020},
  html     = {https://arxiv.org/abs/2006.14556},
  abstract = {Self-supervised anomaly-detection system for autonomous drones: forecasted next video frame with a conditional GAN and IMU vectors with dual LSTM (autoencoder + forecaster); achieved 94% accuracy / 0.95 F1 on video, 100% accuracy / 0.98 F1 on IMU, earning Runner-up, IEEE Signal Processing Cup 2020.},
  selected = {true}
}
