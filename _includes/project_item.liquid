{% assign external_link = project.redirect | default: project.github %}
{% if external_link %}
  {% assign project_link = external_link %}
{% else %}
  {% assign project_link = project.url | relative_url %}
{% endif %}
<article class="entry">
  <a
    class="entry-title"
    href="{{ project_link }}"
    {% if external_link %}
      target="_blank" rel="noopener"
    {% endif %}
  >
    {{- project.title -}}
  </a>
  {% if project.description %}
    <p class="entry-desc">{{ project.description }}</p>
  {% endif %}
  {% if project.tags and project.tags.size > 0 %}
    <div class="entry-meta">
      <span class="entry-tags">
        {% for tag in project.tags %}
          <span class="chip">{{ tag }}</span>
        {% endfor %}
      </span>
    </div>
  {% endif %}
  <a
    class="entry-link"
    href="{{ project_link }}"
    {% if external_link %}
      target="_blank" rel="noopener"
    {% endif %}
    >read more</a
  >
</article>
